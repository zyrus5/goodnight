# 监听地址。需要让局域网内其他机器访问时改为 0.0.0.0。
APP_HOST=127.0.0.1
APP_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/goodnight
# 前后端同域运行时通常无需修改。
FRONTEND_ORIGIN=http://localhost:5173
RUST_LOG=goodnight=info,tower_http=info

# 首次启动空数据库时创建管理员（密码至少 10 位）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
SESSION_SECURE=false
SESSION_HOURS=24

# 所有 Jenkins 共用的公共账户
JENKINS_USERNAME=jenkins-api
JENKINS_PASSWORD=change-me
# 必填。第一个版本用于新数据写入，后续版本用于旧数据解密。
# 生产环境必须替换为随机 32 字节密钥，不能直接使用下方示例值。
APP_ENCRYPTION_KEYS=v1:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# 可选；不配置时 /api/metrics 不对外提供指标。
METRICS_TOKEN=change-metrics-token
SCHEDULER_INTERVAL_SECONDS=5
WORKER_INTERVAL_SECONDS=2
GLOBAL_JOB_CONCURRENCY=16
PER_JENKINS_CONCURRENCY=4
